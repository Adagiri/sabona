# App Configuration
APP_ENV=dev
APP_PORT=3001
APP_DEBUG=true
APP_LOG_LEVEL=1
APP_TOKEN_EXPIRATION=604800000

# Database
APP_DATABASE_URL=postgresql://username:password@host:5432/database_name?schema=public

# Redis
APP_REDIS_HOST=your-redis-host.amazonaws.com
APP_REDIS_PORT=6379

# AWS Configuration
APP_AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY
APP_AWS_SECRET_KEY=YOUR_AWS_SECRET_KEY
APP_AWS_REGION=us-east-1
APP_AWS_BUCKET=your-s3-bucket-name
APP_AWS_BUCKET_BASE_URL=https://s3.us-east-1.amazonaws.com/your-s3-bucket-name
APP_AWS_STS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/your-role-name
APP_AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Twilio Configuration
APP_TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
APP_TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
APP_VERIFY_SERVICE_SID=YOUR_TWILIO_VERIFY_SERVICE_SID

# OAuth Endpoints (Optional - only if using social login)
APP_GOOGLE_OAUTH_ENDPOINT=https://oauth2.googleapis.com/token
APP_APPLE_OAUTH_ENDPOINT=https://appleid.apple.com/auth/token

# Firebase
APP_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-some_id@project_name.iam.gserviceaccount.com
APP_FIREBASE_PROJECT_ID=project_id
APP_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."