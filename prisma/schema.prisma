// This is your Prisma schema file.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["rhel-openssl-1.0.x", "native"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

// UserType enum to classify different types of users in the system
enum UserType {
  USER // Regular customer/user
  VENDOR // Vendor providing services
  RIDER // Rider for order delivery
  ADMIN // Administrator of the system
}

// UserStatus enum to track whether a user is active or inactive
enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

// DeviceType enum to identify the platform used by the user
enum DeviceType {
  WEB
  ANDROID
  IOS
}

enum FeedbackType {
  RIDER_PICKUP
  RIDER_DELIVERY
  VENDOR
}

enum RiderOrderType {
  RIDER_PICKUP
  RIDER_DELIVERY
}

// OrderStatus enum to track the different stages of an order
enum OrderStatus {
  PENDING_PAYMENT // When the order is created and awaiting payment
  PENDING // When the order is created and awaiting vendor action
  ACCEPTED // When a vendor accepts the order
  REJECTED // When a vendor rejects the order
  CANCELLED // When the order is cancelled
  IN_PROGRESS // When the order is being processed by the vendor
  READY_FOR_PICKUP // When the order is ready for pickup by the rider
  COMPLETED // When the entire process is completed
}

// NotificationType enum to define the different types of notifications
enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PROCESSING
  ORDER_REJECTED
  ORDER_PICKED_UP
  ORDER_DELIVERED
  FEEDBACK_SUBMITTED
}

// NotificationStatus enum to track if a notification is read or unread
enum NotificationStatus {
  UNREAD
  READ
}

// TokenReason enum to specify different reasons for token generation (e.g., password reset)
enum TokenReason {
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFICATION
  CHANGE_PASSWORD
}

// MediaType enum to identify the type of media (image, video, etc.)
enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  ARCHIVE
  OTHER
}

// MediaStatus enum to track the current status of media (uploading, ready, etc.)
enum MediaStatus {
  UPLOADING
  READY
  STALE
}

// MediaAccess enum to manage media visibility (public or private)
enum MediaAccess {
  PUBLIC
  PRIVATE
}

enum LEVEL {
  BASIC
  LOYAL
  ELITE
}

enum PaymentType {
  CASH
  CARD
}

// Enum to track the status of the pickup process
enum PickupStatus {
  PENDING // Pickup request available, no rider assigned
  ACCEPTED
  PICKED_UP // Rider has picked up the order from the user
  DELIVERED_TO_VENDOR // Rider has delivered the order to the vendor
}

// Enum to track the status of the delivery process
enum DeliveryStatus {
  PENDING // Delivery request available, no rider assigned
  ACCEPTED
  PICKED_UP_FROM_VENDOR // Rider has picked up the order from the vendor
  DELIVERED_TO_USER // Rider has delivered the order to the user
}

enum DetergentType {
  REGULAR
  SENSITIVE
  USE_MINE
}

enum ColorType {
  LIGHT
  DARK
  MIXED
}

enum DeliveryType {
  NORMAL
  EXPRESS
}

enum PaymentTransactionType {
  ORDER
  TIP
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum TipType {
  RIDER_PICKUP
  RIDER_DELIVERY
}

// User model to store user-related information
model User {
  id               String     @id @default(uuid())
  email            String?
  firstName        String?
  lastName         String?
  password         String?
  phone            String?    @unique
  type             UserType   @default(USER)
  status           UserStatus @default(ACTIVE)
  profilePictureId Int?
  createdAt        DateTime   @default(now()) @db.Timestamptz()
  updatedAt        DateTime   @default(now()) @updatedAt @db.Timestamptz()
  deletedAt        DateTime?  @db.Timestamptz()
  profilePicture   Media?     @relation(fields: [profilePictureId], references: [id])

  level LEVEL? @default(BASIC)

  addresses    UserAddress[]
  devices      Device[]
  tokens       Token[]
  medias       Media[]        @relation("UserMediaOwner")
  settings     UserSettings?
  DeviceToken  DeviceToken[]
  Order        Order[]
  RiderOrder   RiderOrder[]
  Notification Notification[]
  Pickup       Pickup[]
  Delivery     Delivery[]

  feedbacks   Feedback[]
  couponUsage CouponUsage[]
  reward      Reward[]

  givenTips    Tip[] @relation("GivenTips")
  receivedTips Tip[] @relation("ReceivedTips")
}

model Vendor {
  id        String       @id @default(uuid())
  phone     String       
  status    VendorStatus @default(PENDING)
  createdAt DateTime     @default(now()) @db.Timestamptz()
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?    @db.Timestamptz()
  address   String?
  type      UserType     @default(VENDOR)

  // FIELDS FOR ONBOARDING
  laundryName         String // Name provided during signup
  contactPhone        String? // Phone number that riders and customers can call
  latitude            Float // Pinned location latitude
  longitude           Float // Pinned location longitude
  rejectionReason     String? // Admin's reason for rejection
  isDocumentsUploaded Boolean @default(false) // Verification flag

  mainVendorId String? // Points to main vendor if branch
  mainVendor   Vendor?  @relation("VendorBranches", fields: [mainVendorId], references: [id])
  branches     Vendor[] @relation("VendorBranches") // All branches under this main vendor

  // Relations
  devices       Device[]
  tokens        Token[]
  medias        Media[]        @relation("VendorMediaOwner")
  settings      UserSettings?  @relation(fields: [userSettingsId], references: [id])
  deviceTokens  DeviceToken[]
  orders        Order[]
    vendorOrders  VendorOrder[]
  riderOrders   RiderOrder[]
  notifications Notification[]
  pickups       Pickup[]
  deliveries    Delivery[]
  laundries     Laundry[]      @relation("VendorLaundry")
  feedbacks     Feedback[]
  couponUsage   CouponUsage[]
  rewards       Reward[]
  givenTips     Tip[]          @relation("VendorGivenTips")
  receivedTips  Tip[]          @relation("VendorReceivedTips")

  userSettingsId Int?
}

model UserAddress {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  address   String
  lat       Float
  long      Float
  label     String?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model UserSettings {
  id                    Int       @id @default(autoincrement())
  lat                   Float?
  long                  Float?
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id])
  isOnboardingCompleted Boolean   @default(false)
  state                 String?
  city                  String?
  postalCode            String?
  createdAt             DateTime  @default(now()) @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt             DateTime? @db.Timestamptz()
  vendors               Vendor[]
}

model DeviceToken {
  id        Int       @id @default(autoincrement())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  token     String
  deviceId  String
  createdAt DateTime  @default(now()) @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model Device {
  id        Int        @id @default(autoincrement())
  uuid      String     @default(uuid())
  userAgent String?
  type      DeviceType @default(ANDROID)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?    @relation(fields: [vendorId], references: [id])
  createdAt DateTime   @default(now()) @db.Timestamptz()
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?  @db.Timestamptz()
}

model Token {
  id        Int         @id @default(autoincrement())
  uuid      String      @default(uuid())
  code      String
  reason    TokenReason
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?     @relation(fields: [vendorId], references: [id])
  createdAt DateTime    @default(now()) @db.Timestamptz()
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?   @db.Timestamptz()
}

model Media {
  id        Int         @id @default(autoincrement())
  name      String
  extension String
  type      MediaType
  access    MediaAccess
  size      Float?
  location  String?
  path      String
  thumbPath String?
  status    MediaStatus @default(UPLOADING)
  meta      Json?       @db.JsonB
  userId    String?
  user      User?       @relation("UserMediaOwner", fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?     @relation("VendorMediaOwner", fields: [vendorId], references: [id])
  createdAt DateTime    @default(now()) @db.Timestamptz()
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?   @db.Timestamptz()

  // Profile picture relation
  users User[]
}

model Reward {
  id        String    @id @default(uuid())
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  points    Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model Pickup {
  id       String  @id @default(uuid())
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id])
  riderId  String?
  rider    User?   @relation(fields: [riderId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  pickupAddress String
  pickupLat     Float
  pickupLong    Float
  pickupTime    String?
  pickupDate    String?

  status    PickupStatus @default(PENDING)
  createdAt DateTime     @default(now()) @db.Timestamptz()
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?    @db.Timestamptz()
}

model Delivery {
  id       String  @id @default(uuid())
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id])
  riderId  String?
  rider    User?   @relation(fields: [riderId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  deliveryAddress String
  deliveryLat     Float
  deliveryLong    Float
  deliveryTime    String?
  deliveryDate    String?

  status    DeliveryStatus @default(PENDING)
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?      @db.Timestamptz()
}

model Laundry {
  id        String    @id @default(uuid())
  name      String
  address   String
  vendorId  String?
  vendor    Vendor?   @relation("VendorLaundry", fields: [vendorId], references: [id])
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  orders         Order[]
  laundryService LaundryService[]
  feedbacks      Feedback[]
}

model LaundryService {
  id                  String                @id @default(uuid())
  laundryId           String
  laundry             Laundry               @relation(fields: [laundryId], references: [id])
  name                String
  description         String?
  laundryServiceItems LaundryServiceItem[]
  createdAt           DateTime              @default(now()) @db.Timestamptz()
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz()
  deletedAt           DateTime?             @db.Timestamptz()
  OrderLaundryService OrderLaundryService[]
}

model LaundryServiceItem {
  id                      String                    @id @default(uuid())
  laundryServiceId        String
  laundryService          LaundryService            @relation(fields: [laundryServiceId], references: [id])
  name                    String
  price                   Float
  createdAt               DateTime                  @default(now()) @db.Timestamptz()
  updatedAt               DateTime                  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt               DateTime?                 @db.Timestamptz()
  OrderLaundryServiceItem OrderLaundryServiceItem[]
}

model OrderLaundryService {
  id               String                    @id @default(uuid())
  orderId          String
  order            Order                     @relation(fields: [orderId], references: [id])
  laundryServiceId String
  laundryService   LaundryService            @relation(fields: [laundryServiceId], references: [id])
  items            OrderLaundryServiceItem[]
  createdAt        DateTime                  @default(now()) @db.Timestamptz()
  updatedAt        DateTime                  @default(now()) @updatedAt @db.Timestamptz()
}

model OrderLaundryServiceItem {
  id                    String              @id @default(uuid())
  orderLaundryServiceId String
  orderLaundryService   OrderLaundryService @relation(fields: [orderLaundryServiceId], references: [id])
  laundryServiceItemId  String
  laundryServiceItem    LaundryServiceItem  @relation(fields: [laundryServiceItemId], references: [id])
  quantity              Int
  createdAt             DateTime            @default(now()) @db.Timestamptz()
  updatedAt             DateTime            @default(now()) @updatedAt @db.Timestamptz()
}

model Order {
  id             String                @id @default(uuid())
  orderNumber    Int?                  @default(autoincrement())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  laundryId      String
  laundry        Laundry               @relation(fields: [laundryId], references: [id])
  vendorId       String?
  vendor         Vendor?               @relation(fields: [vendorId], references: [id])
  status         OrderStatus           @default(PENDING)
  baseAmount     Float?
  discountAmount Float?
  totalAmount    Float
  couponId       String?
  coupon         Coupon?               @relation(fields: [couponId], references: [id])
  services       OrderLaundryService[]
  payment        Payment?
  paymentType    PaymentType?
  paid           Boolean?

  tip Tip[]

  riderOrders   RiderOrder[]
  vendorOrders  VendorOrder?
  Notification  Notification[]
  feedbacks     Feedback[]
  statusHistory OrderStatusHistory[]
  pickup        Pickup?
  delivery      Delivery?
  deliveryType  DeliveryType         @default(NORMAL)
  detergentType DetergentType?
  colorType     ColorType?
  notes         String?
  createdAt     DateTime             @default(now()) @db.Timestamptz()
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamptz()
  deletedAt     DateTime?            @db.Timestamptz()
}

model RiderOrder {
  id         String          @id @default(uuid())
  riderId    String
  rider      User            @relation(fields: [riderId], references: [id])
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id])
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id])
  assignedAt DateTime        @default(now()) @db.Timestamptz()
  deletedAt  DateTime?       @db.Timestamptz()
  type       RiderOrderType?
  feedbacks  Feedback[]

  @@index([riderId, orderId])
}

model VendorOrder {
  id         String     @id @default(uuid())
  vendorId   String
  vendor     Vendor     @relation(fields: [vendorId], references: [id]) 
  orderId    String     @unique
  order      Order      @relation(fields: [orderId], references: [id])
  acceptedAt DateTime   @default(now()) @db.Timestamptz()
  deletedAt  DateTime?  @db.Timestamptz()
  feedbacks  Feedback[]
}
model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  timestamp DateTime    @default(now()) @db.Timestamptz()
}

model Feedback {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  vendorId      String?
  vendor        Vendor?      @relation(fields: [vendorId], references: [id])
  type          FeedbackType
  rating        Int
  comments      String?
  createdAt     DateTime     @default(now()) @db.Timestamptz()
  deletedAt     DateTime?    @db.Timestamptz()
  VendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id])
  vendorOrderId String?
  RiderOrder    RiderOrder?  @relation(fields: [riderOrderId], references: [id])
  laundryId     String?
  Laundry       Laundry?     @relation(fields: [laundryId], references: [id])
  riderOrderId  String?
}

model Notification {
  id        String             @id @default(uuid())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?            @relation(fields: [vendorId], references: [id])
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  message   String
  orderId   String?
  order     Order?             @relation(fields: [orderId], references: [id])
  createdAt DateTime           @default(now()) @db.Timestamptz()
  data      Json?              @db.JsonB
  deletedAt DateTime?          @db.Timestamptz()
}

model Payment {
  id      String  @id @default(uuid())
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  tipTransactionId String?         @unique
  tipTransaction   TipTransaction? @relation(fields: [tipTransactionId], references: [id])

  paymentType PaymentTransactionType? @default(ORDER)

  transactionRef String
  amount         Float
  type           String
  status         String
  paymentMethod  String

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()
}

model Coupon {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  discount       Float
  type           CouponType
  maxDiscount    Float?
  minOrderAmount Float?
  expiryDate     DateTime
  startDate      DateTime?
  isActive       Boolean       @default(true)
  usageLimit     Int?
  singleUse      Boolean       @default(true)
  orders         Order[]
  couponUsage    CouponUsage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model CouponUsage {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  couponId  String
  coupon    Coupon    @relation(fields: [couponId], references: [id])
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Tip {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], name: "GivenTips")

  riderId String?
  rider   User?   @relation(fields: [riderId], references: [id], name: "ReceivedTips")

  vendorGiverId String?
  vendorGiver   Vendor? @relation(fields: [vendorGiverId], references: [id], name: "VendorGivenTips")

  vendorReceiverId String?
  vendorReceiver   Vendor? @relation(fields: [vendorReceiverId], references: [id], name: "VendorReceivedTips")

  transactionId String?
  transaction   TipTransaction? @relation(fields: [transactionId], references: [id])

  amount    Float
  type      TipType
  paid      Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model TipTransaction {
  id     String @id @default(uuid())
  amount Float
  tips   Tip[]

  payment Payment?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()
}
