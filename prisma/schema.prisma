// This is your Prisma schema file.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

// Key Features:
// Original Models: Your original User, Order, Token, Device, and Media models are preserved.
// Bridge Tables: RiderOrder and VendorOrder tables efficiently manage many-to-many relationships between riders, vendors, and orders.
// Feedback: A new Feedback model for users to leave reviews for completed orders.
// Notifications: A Notification model that tracks in-app, push, or email notifications with NotificationType and NotificationStatus enums.
// Order Status History: The OrderStatusHistory table logs each status change with timestamps.
// This is your Prisma schema file.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client"
  binaryTargets = ["rhel-openssl-1.0.x", "native"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

// UserType enum to classify different types of users in the system
enum UserType {
  USER // Regular customer/user
  VENDOR // Vendor providing services
  RIDER // Rider for order delivery
  ADMIN // Administrator of the system
}

// UserStatus enum to track whether a user is active or inactive
enum UserStatus {
  ACTIVE
  INACTIVE
}

// DeviceType enum to identify the platform used by the user
enum DeviceType {
  WEB
  ANDROID
  IOS
}

// OrderStatus enum to track the different stages of an order
enum OrderStatus {
  PENDING_PAYMENT // When the order is created and awaiting payment
  PENDING // When the order is created and awaiting vendor action
  ACCEPTED // When a vendor accepts the order
  REJECTED // When a vendor rejects the order
  CANCELLED // When the order is cancelled
  IN_PROGRESS // When the order is being processed by the vendor
  READY_FOR_PICKUP // When the order is ready for pickup by the rider
  COMPLETED // When the entire process is completed
}

// NotificationType enum to define the different types of notifications
enum NotificationType {
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PICKED_UP
  ORDER_DELIVERED
  FEEDBACK_SUBMITTED
}

// NotificationStatus enum to track if a notification is read or unread
enum NotificationStatus {
  UNREAD
  READ
}

// TokenReason enum to specify different reasons for token generation (e.g., password reset)
enum TokenReason {
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFICATION
  CHANGE_PASSWORD
}

// MediaType enum to identify the type of media (image, video, etc.)
enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  ARCHIVE
  OTHER
}

// MediaStatus enum to track the current status of media (uploading, ready, etc.)
enum MediaStatus {
  UPLOADING
  READY
  STALE
}

// MediaAccess enum to manage media visibility (public or private)
enum MediaAccess {
  PUBLIC
  PRIVATE
}

enum LEVEL {
  BASIC
  LOYAL
  ELITE
}

enum PaymentType {
  CASH
  CARD
}

// User model to store user-related information
model User {
  id               String     @id @default(uuid()) // Now using UUID for user ID
  email            String? // Optional email field
  firstName        String? // Optional first name
  lastName         String? // Optional last name
  password         String? // Optional password field
  phone            String     @unique // Unique phone number for each user
  type             UserType   @default(USER) // Defines if user is USER, VENDOR, RIDER, etc.
  status           UserStatus @default(ACTIVE) // Active or inactive status
  profilePictureId Int? // Optional relation to user's profile picture
  createdAt        DateTime   @default(now()) @db.Timestamptz()
  updatedAt        DateTime   @default(now()) @updatedAt @db.Timestamptz()
  deletedAt        DateTime?  @db.Timestamptz() // Optional deleted at timestamp
  profilePicture   Media?     @relation(fields: [profilePictureId], references: [id])

  level            LEVEL? @default(BASIC)// User level

  addresses UserAddress[] // A user can have multiple addresses

  devices      Device[] // Relation to devices used by the user
  tokens       Token[] // Authentication tokens used by the user
  medias       Media[]        @relation("MediaOwner") // Media files uploaded by the user
  settings     UserSettings? // Relation to user settings
  DeviceToken  DeviceToken[]
  Order        Order[]
  RiderOrder   RiderOrder[]
  VendorOrder  VendorOrder[]
  Notification Notification[]
  Pickup       Pickup[]
  Delivery     Delivery[]
  laundry      Laundry[]       @relation("VendorLaundry")
}

model UserAddress {
  id        String    @id @default(uuid()) // UUID for address ID
  userId    String // Foreign key to the User model
  user      User      @relation(fields: [userId], references: [id])
  address   String // The actual address (e.g., street, city, etc.)
  lat       Float // Latitude of the address
  long      Float // Longitude of the address
  label     String? // Optional label (e.g., "Home", "Work")
  isDefault Boolean   @default(false) // Whether this is the default address
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

// UserSettings model for storing user-specific settings (e.g., location)
model UserSettings {
  id                    Int       @id @default(autoincrement()) // Using Int for settings ID
  lat                   Float?
  long                  Float?
  userId                String    @unique // Changed to String to match User's UUID
  user                  User      @relation(fields: [userId], references: [id])
  isOnboardingCompleted Boolean   @default(false) // Flag to track onboarding completion
  createdAt             DateTime  @default(now()) @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt             DateTime? @db.Timestamptz()
}

// DeviceToken model to store device tokens for push notifications
model DeviceToken {
  id        Int      @id @default(autoincrement()) // Using Int for device token ID
  userId    String // Changed to String to match User's UUID
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique // Unique push token for each device
  createdAt DateTime @default(now()) @db.Timestamptz()
  deletedAt DateTime?  @db.Timestamptz() // Optional deletion timestamp
}

// Device model to store devices used by users (for web, iOS, Android)
model Device {
  id        Int        @id @default(autoincrement()) // Using Int for device ID
  uuid      String     @default(uuid()) // Unique identifier for each device
  userAgent String? // Optional user agent string
  type      DeviceType @default(ANDROID) // Default device type is Android
  userId    String // Changed to String to match User's UUID
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now()) @db.Timestamptz()
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?  @db.Timestamptz() // Optional deletion timestamp
}

// Token model to manage tokens for authentication (e.g., password reset)
model Token {
  id        Int         @id @default(autoincrement()) // Using Int for token ID
  uuid      String      @default(uuid())
  code      String // Token code (e.g., OTP)
  reason    TokenReason // Reason for the token (password reset, etc.)
  userId    String?
  createdAt DateTime    @default(now()) @db.Timestamptz()
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?   @db.Timestamptz()
  user      User?       @relation(fields: [userId], references: [id])
}

// Media model to store media files uploaded by users
model Media {
  id        Int         @id @default(autoincrement()) // Using Int for media ID
  name      String // Media name
  extension String // File extension (e.g., jpg, png)
  type      MediaType // Media type (image, video, etc.)
  access    MediaAccess // Access level (public/private)
  size      Float?
  location  String? // Optional location URL
  path      String // Path to the file
  thumbPath String? // Optional thumbnail path
  status    MediaStatus @default(UPLOADING) // Upload status
  meta      Json?       @db.JsonB
  userId    String?
  createdAt DateTime    @default(now()) @db.Timestamptz()
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?   @db.Timestamptz()
  user      User?       @relation("MediaOwner", fields: [userId], references: [id])
  users     User[] // Users related to this media (for example, profile pictures)
}

// Order model to represent a user's order
// UserAddress model to store multiple addresses for each user

// Enum to track the status of the pickup process
enum PickupStatus {
  PENDING // Pickup request available, no rider assigned
  ACCEPTED
  PICKED_UP // Rider has picked up the order from the user
  DELIVERED_TO_VENDOR // Rider has delivered the order to the vendor
}

// Enum to track the status of the delivery process
enum DeliveryStatus {
  PENDING // Delivery request available, no rider assigned
  ACCEPTED
  PICKED_UP_FROM_VENDOR // Rider has picked up the order from the vendor
  DELIVERED_TO_USER // Rider has delivered the order to the user
}

enum DetergentType {
  REGULAR
  SENSITIVE
  USE_MINE
}

enum ColorType {
  LIGHT
  DARK
  MIXED
}

enum DeliveryType {
  NORMAL
  EXPRESS
}
// Pickup model to track the pickup of the order from the user to the vendor
model Pickup {
  id      String  @id @default(uuid()) // UUID for pickup ID
  orderId String  @unique // The related order
  order   Order   @relation(fields: [orderId], references: [id])
  riderId String? // The rider responsible for the pickup (optional initially)
  rider   User?   @relation(fields: [riderId], references: [id])

  // Store the snapshot of the pickup address
  pickupAddress String // The address for pickup
  pickupLat     Float // Latitude for pickup location
  pickupLong    Float // Longitude for pickup location

  //Store the pickup address and time 
  pickupTime String? // Time for pickup
  pickupDate String? // Date for pickup

  status    PickupStatus @default(PENDING) // Status of the pickup process
  createdAt DateTime     @default(now()) @db.Timestamptz()
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?    @db.Timestamptz()
}

// Delivery model to track the delivery of the order from the vendor back to the user
model Delivery {
  id      String  @id @default(uuid()) // UUID for delivery ID
  orderId String  @unique // The related order
  order   Order   @relation(fields: [orderId], references: [id])
  riderId String? // The rider responsible for the delivery (optional initially)
  rider   User?   @relation(fields: [riderId], references: [id])

  // Store the snapshot of the delivery address
  deliveryAddress String // The address for delivery
  deliveryLat     Float // Latitude for delivery location
  deliveryLong    Float // Longitude for delivery location

  //Store the address and time for delivery
  deliveryTime String? // Time for delivery
  deliveryDate String? // Date for delivery

  status    DeliveryStatus @default(PENDING) // Status of the delivery process
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime?      @db.Timestamptz()
}

model Laundry {
  id             String           @id @default(uuid())
  name           String // Name of the laundry
  address        String // Address of the laundry
  vendor         User?            @relation("VendorLaundry", fields: [vendorId], references: [id])
  vendorId       String?          
  createdAt      DateTime         @default(now()) @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz()
  deletedAt      DateTime?        @db.Timestamptz()
  Order          Order[]
  laundryService LaundryService[]
}

model LaundryService {
  id                  String                @id @default(uuid())
  laundryId           String // Foreign key to Laundry model
  laundry             Laundry               @relation(fields: [laundryId], references: [id])
  name                String // Name of the service (e.g., "Wash & Fold")
  description         String? // Optional description of the service
  laundryServiceItems LaundryServiceItem[] // Relation to LaundryServiceItem model
  createdAt           DateTime              @default(now()) @db.Timestamptz()
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz()
  deletedAt           DateTime?             @db.Timestamptz()
  OrderLaundryService OrderLaundryService[]
}

model LaundryServiceItem {
  id                      String                    @id @default(uuid())
  laundryServiceId        String // Foreign key to LaundryService model
  laundryService          LaundryService            @relation(fields: [laundryServiceId], references: [id])
  name                    String // Name of the item (e.g., "T-shirt")
  price                   Float // Price of the item
  createdAt               DateTime                  @default(now()) @db.Timestamptz()
  updatedAt               DateTime                  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt               DateTime?                 @db.Timestamptz()
  OrderLaundryServiceItem OrderLaundryServiceItem[]
}

// Represents the association between orders and laundry services
model OrderLaundryService {
  id               String                    @id @default(uuid())
  orderId          String
  order            Order                     @relation(fields: [orderId], references: [id])
  laundryServiceId String
  laundryService   LaundryService            @relation(fields: [laundryServiceId], references: [id])
  items            OrderLaundryServiceItem[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()
}

// Represents the association between an order service and service items
model OrderLaundryServiceItem {
  id                    String              @id @default(uuid())
  orderLaundryServiceId String
  orderLaundryService   OrderLaundryService @relation(fields: [orderLaundryServiceId], references: [id])
  laundryServiceItemId  String
  laundryServiceItem    LaundryServiceItem  @relation(fields: [laundryServiceItemId], references: [id])
  quantity              Int // Quantity of each item ordered

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()
}

// Update the Order model to include pickup and delivery addresses
// Order model to represent a user's order
model Order {
  id          String                @id @default(uuid()) // UUID for order ID
  userId      String // User who placed the order
  user        User                  @relation(fields: [userId], references: [id])
  laundryId   String // Foreign key to the Laundry model
  laundry     Laundry               @relation(fields: [laundryId], references: [id])
  status      OrderStatus           @default(PENDING) // High-level status of the order
  totalAmount Float // Total amount for the order
  services    OrderLaundryService[]
  payment     Payment? // Payment details for the order
  paymentType PaymentType? // Payment type for the order
  paid        Boolean? 

  riderOrders   RiderOrder[] // Existing relation with riders for order management
  vendorOrders  VendorOrder? // Existing relation with vendors for order management
  Notification  Notification[] // Notifications related to the order
  feedback      Feedback? // Optional feedback from the customer
  statusHistory OrderStatusHistory[] // History of order status changes
  pickup        Pickup? // Relation to the pickup tracking
  delivery      Delivery? // Relation to the delivery tracking
  deliveryType  DeliveryType @default(NORMAL) // Type of delivery (normal/express)
  detergentType DetergentType? // Type of detergent used
  colorType     ColorType? // Type of color (light/dark/mixed)
  notes         String? // Additional notes for the order

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

// RiderOrder model to manage assignments between riders and orders
model RiderOrder {
  id         String    @id @default(uuid()) // Now using UUID for rider-order relation ID
  riderId    String
  rider      User      @relation(fields: [riderId], references: [id])
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  assignedAt DateTime  @default(now()) @db.Timestamptz() // When the rider was assigned
  deletedAt  DateTime? @db.Timestamptz()

  @@index([riderId, orderId]) // Optional: Index for efficient querying on riderId and orderId
}


// VendorOrder model to manage assignments between vendors and orders
model VendorOrder {
  id         String    @id @default(uuid()) // Now using UUID for vendor-order relation ID
  vendorId   String // Vendor assigned to the order
  vendor     User      @relation(fields: [vendorId], references: [id])
  orderId    String    @unique // Using UUID for orderId field
  order      Order     @relation(fields: [orderId], references: [id])
  acceptedAt DateTime  @default(now()) @db.Timestamptz() // When the vendor accepted the order
  deletedAt  DateTime? @db.Timestamptz()
}

// OrderStatusHistory model to track all status changes for an order
model OrderStatusHistory {
  id        String      @id @default(uuid()) // Now using UUID for status history ID
  orderId   String // Using UUID for orderId field
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus // The status change
  timestamp DateTime    @default(now()) @db.Timestamptz() // When the status was updated
}

// Feedback model to store user feedback on completed orders
model Feedback {
  id        String   @id @default(uuid()) // Now using UUID for feedback ID
  orderId   String   @unique // Ensuring only one feedback per order
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int // Numerical rating, for example, 1-5 stars
  comments  String? // Optional text feedback from the user
  createdAt DateTime @default(now()) @db.Timestamptz() // Timestamp for feedback creation
}

// Notification model to track in-app, push, and email notifications
model Notification {
  id        String             @id @default(uuid()) // Now using UUID for notification ID
  userId    String // User receiving the notification
  user      User               @relation(fields: [userId], references: [id])
  type      NotificationType // Type of notification (order accepted, feedback, etc.)
  status    NotificationStatus @default(UNREAD) // Status of the notification (read/unread)
  message   String // Custom message for the notification
  orderId   String?            @unique // Ensuring only one notification per order if applicable
  order     Order?             @relation(fields: [orderId], references: [id])
  createdAt DateTime           @default(now()) @db.Timestamptz() // Timestamp for notification creation
}

model Payment {
  id                   String   @id @default(uuid()) // UUID for payment ID
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id])

  transactionRef       String   // PayTabs transaction reference
  amount     Float    // Total transaction amount
  type      String   // Type of transaction (e.g., Sale, Refund)
  status        String   // Payment Status 
  paymentMethod        String   // Payment Method (e.g., Visa, MasterCard)

  createdAt            DateTime @default(now()) @db.Timestamptz() // Timestamp of creation
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz() // Timestamp of last update
}